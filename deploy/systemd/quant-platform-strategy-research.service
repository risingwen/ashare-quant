[Unit]
Description=Refresh A-share strategy review pages
After=network.target postgresql.service quant-platform-popularity-sync.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/data/quant_research
EnvironmentFile=-/data/quant_research/config/quant-platform.env
ExecStart=/data/quant_research_venv/bin/python /data/quant_research/scripts/refresh_strategy_research.py
NoNewPrivileges=true
PrivateTmp=true
