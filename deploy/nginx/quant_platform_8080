server {
    listen 8080 default_server;
    server_name _;
    root /data/quant_research/apps/web/dist;
    index index.html;
    location /api/ { proxy_pass http://127.0.0.1:8081; proxy_set_header Host $host; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; }
    location = /docs.html { alias /data/quant_research/reports/latest/docs.html; }
    location / { try_files $uri /index.html; }
    gzip on;
    gzip_types application/json text/css application/javascript;
}
